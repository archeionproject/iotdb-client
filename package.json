{
  "name": "@archeion/iotdb-client",
  "description": "A client to interact with IoTDb in Nodejs applications",
  "version": "0.1.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "author": "Cristiano Aguzzi",
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.14.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/jest": "^29.5.14",
    "@types/thrift": "^0.10.17",
    "@typescript-eslint/parser": "^8.50.0",
    "app-root-path": "^3.1.0",
    "axios": "^1.7.9",
    "detect-port": "^2.1.0",
    "docker-compose": "^1.1.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^15.12.0",
    "is-ci": "^4.1.0",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "ts-jest": "^29.4.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.50.0"
  },
  "dependencies": {
    "exponential-backoff": "^3.1.3",
    "node-int64": "^0.4.0",
    "thrift": "^0.21.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "test",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
